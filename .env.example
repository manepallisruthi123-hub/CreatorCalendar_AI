PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace_with_secure_random_secret
GEMINI_API_KEY=replace_with_gemini_api_key
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google OAuth 2.0 Credentials (Working for Continue with Google & YouTube API)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Multi-Platform Integration API Credentials (Official OAuth/Graph APIs)
# 1. Instagram Graph API (Meta for Developers)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/accounts

# 2. YouTube Data API v3 (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/accounts

# 3. TikTok Login Kit (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/accounts

# 4. LinkedIn OAuth 2.0 (LinkedIn Developer Portal)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/accounts

# 5. Facebook Graph API (Meta for Developers)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/accounts
